# ==========================================
# DOCKER ENVIRONMENT - Production-like setup
# ==========================================

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_ROOT_PASSWORD=root_secure_password_change_me
DB_USER=saes_user
DB_PASS=saes_secure_password_change_me
DB_HOST=db
DB_PORT=3306
DB_NAME=saes2

# ==========================================
# API CONFIGURATION
# ==========================================
API_PORT=3000
NODE_ENV=production
PORT=3000

# JWT Configuration - CHANGE IN PRODUCTION
JWT_SECRET=change_this_to_a_super_secret_key_min_32_chars_in_production
JWT_EXPIRES_IN=8h

# SMTP Configuration (Gmail with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=noreply@saes2.edu.mx

# Frontend URL (for password reset links)
FRONTEND_URL=http://saes2.local

# API Base URL (internal Docker network)
API_BASE_URL=http://api:3000

# ==========================================
# AI/CHATBOT CONFIGURATION
# ==========================================
AI_PORT=8000
GROQ_API_KEY=your_groq_api_key_here
AI_BASE_URL=http://ai:8000

# ==========================================
# WEB CONFIGURATION
# ==========================================
WEB_PORT=80
VITE_API_URL=http://api:3000
VITE_AI_URL=http://ai:8000
