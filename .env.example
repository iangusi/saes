# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_ROOT_PASSWORD=root
DB_USER=root
DB_PASS=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=saes2

# ==========================================
# API CONFIGURATION
# ==========================================
API_PORT=3000
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_SECRET=your_super_secret_key_min_32_chars_change_in_production
JWT_EXPIRES_IN=8h

# SMTP Configuration (Gmail, Office365, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=no-reply@saes2.edu.mx

# Frontend URL (for password reset links and CORS)
FRONTEND_URL=http://localhost:5173

# API Base URL (for web client)
API_BASE_URL=http://localhost:3000

# ==========================================
# AI/CHATBOT CONFIGURATION
# ==========================================
